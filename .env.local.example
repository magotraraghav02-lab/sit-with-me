# Supabase project settings (Project Settings > API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public WhatsApp number customers see (floating button), digits only with country code
NEXT_PUBLIC_WHATSAPP_NUMBER=919310891615

# Internal/admin reference WhatsApp number (shown in admin panel only)
ADMIN_WHATSAPP_NUMBER=918618141090

# Where new-booking email alerts are sent
NOTIFY_EMAIL=magotraraghav02@gmail.com

# Optional: Resend API key to enable email notifications (https://resend.com)
# Leave blank to skip emails - bookings still save to the database and show in /admin.
RESEND_API_KEY=
