# Supabase project settings (Project Settings > API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public WhatsApp number customers see (floating button, sticky bar), digits only with country code
NEXT_PUBLIC_WHATSAPP_NUMBER=919310891615

# Internal/admin reference WhatsApp number (shown in admin panel only)
ADMIN_WHATSAPP_NUMBER=918618141090

# Public contact email shown on /contact
NEXT_PUBLIC_CONTACT_EMAIL=hello@sitwithme.in

# Where new-booking / payment-received email alerts are sent
NOTIFY_EMAIL=magotraraghav02@gmail.com

# Resend API key to enable email notifications (https://resend.com, free tier)
# Leave blank to skip emails - bookings still save and show in /admin.
RESEND_API_KEY=

# Telegram booking alerts (optional, alongside email/WhatsApp)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=

# Razorpay (test-mode keys are fine for local dev; live payments are created
# manually in the Razorpay app per the Individual-account limitation -- see
# src/app/payment-actions.ts)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Meta (Facebook) Pixel + Conversions API — see README "Verify Meta events" section
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
# Optional: set while testing in Meta Events Manager's "Test events" tab, then remove for production
META_TEST_EVENT_CODE=

# Shared secret the abandoned-checkout cron endpoint checks for
# (see /api/cron/sweep-bookings and the README's cron setup section)
CRON_SECRET=
